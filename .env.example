# PostgreSQL connection for the API
DATABASE_URL=postgresql://floatchat_api:your_password_here@localhost:5432/floatchat

# Free-form query generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Profile-summary index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store

# Comma-separated frontend origins for a hosted API
CORS_ORIGINS=

# Ingestion paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
